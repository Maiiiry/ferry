# Ferry: lets /usr/local/bin/ferry create user namespaces; what it runs gets no capabilities in them.
# Managed by `ferry setup apparmor`; remove with `ferry setup apparmor --uninstall`.
# The path must be root-owned and not writable by users.
# Manual install: sudo install -m 644 this-file /etc/apparmor.d/usr.local.bin.ferry && sudo apparmor_parser -r /etc/apparmor.d/usr.local.bin.ferry
abi <abi/4.0>,
include <tunables/global>

profile ferry /usr/local/bin/ferry flags=(attach_disconnected) {
  allow capability,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,
  # ferry re-running itself (the namespace probe) must keep its capabilities;
  # an exact path takes precedence over the pattern below.
  allow ix /usr/local/bin/ferry,
  allow px /** -> ferry//&unpriv_ferry,

  include if exists <local/ferry>
}

profile unpriv_ferry flags=(attach_disconnected) {
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,
  allow pix /** -> &unpriv_ferry,
  audit deny capability,

  include if exists <local/unpriv_ferry>
}
