#!/usr/bin/env bash
# cargo-fleet: warm, forkable Rust build state for parallel agent worktrees (Linux).
#
#   cargo-fleet base   [ref]        build/refresh the warm base for <ref> (default HEAD)
#   cargo-fleet spawn  <name>       new worktree + overlayfs fork of the base target/
#   cargo-fleet run    <name> cmd.. run cmd inside the agent's canonical sandbox
#   cargo-fleet shell  <name>       interactive shell in the sandbox (point your agent here)
#   cargo-fleet rm     <name>       remove agent worktree + its upper layer
#   cargo-fleet gc                  delete bases no agent or "current" uses
#
# How it works:
#  - Fixed mtimes on tracked files: Cargo's freshness check is mtime-based, so a fresh
#    checkout looks dirty. Stamping makes the base's artifacts valid for every agent
#    (crate-level reuse).
#  - Same path for every worktree (/work, /wtarget) via a private mount namespace:
#    rustc's incremental cache embeds absolute paths, so this keeps query-level reuse
#    (measured ~3x faster first edit than the same fork at a different path).
#  - Target dir = overlayfs over an immutable per-commit base: zero-copy fork, works
#    on ext4, each agent has its own upper layer. Never share one target dir across
#    worktrees: mtime freshness can silently hand agent B agent A's artifacts.
set -euo pipefail

REPO=${FLEET_REPO:-$(git rev-parse --show-toplevel)}
ROOT=${FLEET_ROOT:-$REPO/.fleet}
STAMP=${FLEET_STAMP:-@1700000000}
BASE_CMD=${FLEET_BASE_CMD:-"cargo build --all-targets"}
mkdir -p "$ROOT/agents"

die() { echo "cargo-fleet: $*" >&2; exit 1; }

stamp_tree() { (cd "$1" && git ls-files -z | xargs -0 touch -h -d "$STAMP"); }

# sandbox <worktree> <target-mountpoint-setup> <cmd...>
sandbox() {
  local wt=$1 tgt_setup=$2; shift 2
  unshare -m --propagation private bash -c '
    set -e; mkdir -p /work /wtarget
    mount --bind "$1" /work
    eval "$2"
    shift 2
    cd /work; export CARGO_TARGET_DIR=/wtarget
    exec "$@"' _ "$wt" "$tgt_setup" "$@"
}

cmd_base() {
  # Bases are immutable and versioned per commit: a live agent's overlay lower
  # layer must never change underneath it. New agents fork from "current".
  local rev; rev=$(git -C "$REPO" rev-parse "${1:-HEAD}")
  local b=$ROOT/bases/$rev
  if [[ ! -f $b/ready ]]; then
    git -C "$REPO" worktree add -q --detach "$b/src" "$rev" 2>/dev/null || true
    mkdir -p "$b/target"; stamp_tree "$b/src"
    sandbox "$b/src" "mount --bind '$b/target' /wtarget" bash -c "$BASE_CMD"
    touch "$b/ready"
  fi
  ln -sfn "$b" "$ROOT/current"
  echo "base ready at ${rev:0:12}"
}

cmd_spawn() {
  local name=${1:?name} a=$ROOT/agents/$1 b
  b=$(readlink -f "$ROOT/current" 2>/dev/null) || true
  [[ -f ${b:-/nonexistent}/ready ]] || die "no base; run: cargo-fleet base"
  [[ -e $a ]] && die "agent $name exists"
  mkdir -p "$a"/{upper,work}; ln -s "$b" "$a/base"
  local rev; rev=$(basename "$b")
  git -C "$REPO" worktree add -q -b "fleet/$name" "$a/src" "$rev"
  stamp_tree "$a/src"
  echo "spawned $name -> $a/src (forked from base ${rev:0:12})"
}

agent_target_setup() {
  local a=$ROOT/agents/$1 b; b=$(readlink -f "$ROOT/agents/$1/base")
  echo "mount -t overlay overlay -o lowerdir='$b/target',upperdir='$a/upper',workdir='$a/work' /wtarget"
}

cmd_run()   { local n=${1:?name}; shift; sandbox "$ROOT/agents/$n/src" "$(agent_target_setup "$n")" "$@"; }
cmd_shell() { cmd_run "${1:?name}" "${SHELL:-bash}"; }

cmd_rm() {
  local a=$ROOT/agents/${1:?name}
  git -C "$REPO" worktree remove --force "$a/src" 2>/dev/null || true
  git -C "$REPO" branch -D "fleet/$1" -q 2>/dev/null || true
  rm -rf "$a"; echo "removed $1"
}

cmd_gc() {
  local live; live=$( { readlink -f "$ROOT/current"; for l in "$ROOT"/agents/*/base; do readlink -f "$l"; done; } 2>/dev/null | sort -u)
  for b in "$ROOT"/bases/*/; do b=${b%/}
    grep -qxF "$b" <<<"$live" && continue
    git -C "$REPO" worktree remove --force "$b/src" 2>/dev/null || true; rm -rf "$b"; echo "gc $(basename "$b" | cut -c1-12)"
  done
}

case ${1:-} in
  base|spawn|run|shell|rm|gc) c=$1; shift; "cmd_$c" "$@" ;;
  *) sed -n '2,10p' "$0"; exit 1 ;;
esac
